 Identification Division.
 Program-ID. ExecDli.
 Procedure Division.

  EXEC DLI SCHD
       PSB((PSB-NAME))
       NODHABEND
  END-EXEC.

  EXEC DLI GU USING PCB(PAUT-PCB-NUM)
      SEGMENT (PAUTSUM0)
      INTO (PENDING-AUTH-SUMMARY)
      WHERE (ACCNTID = PA-ACCT-ID)
  END-EXEC.

  EXEC DLI GN USING PCB(PAUT-PCB-NUM)
      SEGMENT (PAUTSUM0)
      INTO (PENDING-AUTH-SUMMARY)
  END-EXEC.

  IF STATUS-OK
    EXEC DLI GNP USING PCB(PAUT-PCB-NUM)
        SEGMENT (PAUTDTL1)
        INTO (PENDING-AUTH-DETAILS)
        WHERE (PAUT9CTS = PA-AUTHORIZATION-KEY)
    END-EXEC
    MOVE DIBSTAT TO IMS-RETURN-CODE
  END-IF.

  EXEC DLI DLET USING PCB(PAUT-PCB-NUM)
      SEGMENT (PAUTDTL1)
      FROM (PENDING-AUTH-DETAILS)
  END-EXEC.

  EXEC DLI REPL USING PCB(PAUT-PCB-NUM)
      SEGMENT (PAUTSUM0)
      FROM (PENDING-AUTH-SUMMARY)
  END-EXEC.

  EXEC DLI ISRT USING PCB(PAUT-PCB-NUM)
      SEGMENT (PAUTSUM0)
      WHERE (ACCNTID = PA-ACCT-ID)
      SEGMENT (PAUTDTL1)
      FROM (PENDING-AUTH-DETAILS)
      SEGLENGTH (LENGTH OF PENDING-AUTH-DETAILS)
  END-EXEC.

  EXEC DLI CHKP ID(WK-CHKPT-ID)
  END-EXEC.

  EXEC DLI TERM END-EXEC.

  EXEC DLI GHU USING PCB(1)
      SEGMENT (PAUTSUM0)
      INTO (PENDING-AUTH-SUMMARY)
  END-EXEC.

  EXEC DLI GHN USING PCB(PAUT-PCB-NUM)
      SEGMENT (PAUTSUM0)
      INTO (PENDING-AUTH-SUMMARY)
  END-EXEC.

  EXEC DLI GHNP USING PCB(PAUT-PCB-NUM)
      SEGMENT (PAUTDTL1)
      INTO (PENDING-AUTH-DETAILS)
      WHERE (PAUT9CTS = PA-AUTHORIZATION-KEY)
  END-EXEC.

  STOP RUN.
